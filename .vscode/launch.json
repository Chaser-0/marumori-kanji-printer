{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Chrome",
      "request": "launch",
      "type": "chrome",
      "url": "http://127.0.0.1:3000",
      "webRoot": "${workspaceFolder}/",
      "sourceMapPathOverrides": {
        "/web/vite/*": "${workspaceFolder}/*",
      },
      "sourceMaps": true,
      "preLaunchTask": "Launch marumoro-kanji-printer dev server",
      "runtimeArgs": ["--disable-web-security"]
    }
  ]
}
